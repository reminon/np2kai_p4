build esp-idf/esp_partition/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/esp_partition && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

