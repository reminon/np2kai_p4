  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/riscv/install/local: phony esp-idf/riscv/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/riscv/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/riscv/all
