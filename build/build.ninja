  DESC = No interactive CMake dialog available...
  restat = 1

build esp-idf/esp_mm/edit_cache: phony esp-idf/esp_mm/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/esp_mm/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
