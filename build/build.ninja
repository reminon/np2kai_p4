  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/efuse && /root/.espressif/python_env/idf5.5_py3.13_env/bin/python /root/esp/esp-idf/components/efuse/efuse_table_gen.py /root/esp/esp-idf/components/efuse/esp32p4/esp_efuse_table.csv -t esp32p4 --max_blk_len 256 --info


#############################################
