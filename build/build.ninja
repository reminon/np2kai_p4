  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/soc/install/local: phony esp-idf/soc/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/soc/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/soc/all
