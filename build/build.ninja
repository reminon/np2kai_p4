  DESC = No interactive CMake dialog available...
  restat = 1

build esp-idf/esp_http_server/edit_cache: phony esp-idf/esp_http_server/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/esp_http_server/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
