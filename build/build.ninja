# Utility command for edit_cache

build esp-idf/soc/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/soc && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build esp-idf/soc/edit_cache: phony esp-idf/soc/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/soc/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/soc && /usr/bin/cmake --regenerate-during-build -S/root/projects/np2kai_p4 -B/root/projects/np2kai_p4/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/soc/rebuild_cache: phony esp-idf/soc/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/soc/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/soc/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/soc/all
  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/soc && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/soc/install: phony esp-idf/soc/CMakeFiles/install.util


#############################################
# Utility command for install/local

build esp-idf/soc/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/soc/all
