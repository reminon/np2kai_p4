  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/partition_table && /usr/bin/cmake -E echo "Partition table binary generated. Contents:" && /usr/bin/cmake -E echo "*******************************************************************************" && /root/.espressif/python_env/idf5.5_py3.13_env/bin/python /root/esp/esp-idf/components/partition_table/gen_esp32part.py -q --offset 0x8000 --primary-bootloader-offset 0x2000 --flash-size 16MB -- /root/projects/np2kai_p4/build/partition_table/partition-table.bin && /usr/bin/cmake -E echo "*******************************************************************************"


