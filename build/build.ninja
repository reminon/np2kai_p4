#############################################
# Utility command for edit_cache

build esp-idf/esp-tls/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build/esp-idf/esp-tls && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build esp-idf/esp-tls/edit_cache: phony esp-idf/esp-tls/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/esp-tls/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
