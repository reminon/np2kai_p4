build esp-idf/esp_wifi/libesp_wifi.a: C_STATIC_LIBRARY_LINKER____idf_esp_wifi_ esp-idf/esp_wifi/CMakeFiles/__idf_esp_wifi.dir/src/wifi_default.c.obj esp-idf/esp_wifi/CMakeFiles/__idf_esp_wifi.dir/src/wifi_netif.c.obj esp-idf/esp_wifi/CMakeFiles/__idf_esp_wifi.dir/src/wifi_default_ap.c.obj || esp-idf/esp_driver_spi/libesp_driver_spi.a
