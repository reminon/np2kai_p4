#############################################
# Custom command for CMakeFiles/dfu-list

build CMakeFiles/dfu-list | ${cmake_ninja_workdir}CMakeFiles/dfu-list: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build && /usr/bin/cmake -D ESP_DFU_LIST="1" -P /root/esp/esp-idf/tools/cmake/run_dfu_util.cmake
  pool = console


#############################################
# Custom command for CMakeFiles/dfu-flash

build CMakeFiles/dfu-flash | ${cmake_ninja_workdir}CMakeFiles/dfu-flash: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build && /usr/bin/cmake -D ESP_DFU_BIN="/root/projects/np2kai_p4/build/dfu.bin" -D ESP_DFU_PID="12" -P /root/esp/esp-idf/tools/cmake/run_dfu_util.cmake
  pool = console


#############################################
# Custom command for CMakeFiles/uf2

build CMakeFiles/uf2 | ${cmake_ninja_workdir}CMakeFiles/uf2: CUSTOM_COMMAND
  COMMAND = cd /root/projects/np2kai_p4/build && /usr/bin/cmake -D IDF_PATH=/root/esp/esp-idf -D "UF2_CMD=/root/.espressif/python_env/idf5.5_py3.13_env/bin/python;/root/esp/esp-idf/tools/mkuf2.py;write;--chip;esp32p4" -D "UF2_ARGS=--json;/root/projects/np2kai_p4/build/flasher_args.json;-o;/root/projects/np2kai_p4/build/uf2.bin" -P /root/esp/esp-idf/tools/cmake/run_uf2_cmds.cmake
  pool = console


